{
  // ============================================================
  //  File: users.json
  //  Purpose:
  //    - 描述 MySQL 数据库中 "users" 表的结构
  //    - 供 code agent / LLM 自动识别字段类型、用途、约束
  //    - 可用于自动生成 SQL、API、ORM 模型、校验规则等
  //
  //  MySQL Access:
  //    - 数据库通过 /config.php 中的 PDO 方式连接，例如：
  //        $pdo = new PDO($dsn, $username, $password);
  //    - agent 可根据此结构自动构建 SQL 查询或数据模型
  //
  //  Notes:
  //    - 此文件仅描述结构，不包含真实数据
  //    - 字段类型为推断类型，可根据实际数据库进一步调整
  // ============================================================

  "table": "users",

  "columns": {
    "uid": "INT PRIMARY KEY AUTO_INCREMENT",   // 用户唯一 ID
    "email": "VARCHAR",                        // 邮箱
    "nickname": "VARCHAR",                     // 昵称,同realname,username
    "locale": "VARCHAR",                       // 语言区域
    "score": "INT",                            // 分数或积分
    "avatar": "VARCHAR",                       // 头像 URL
    "password": "VARCHAR",                     // 密码哈希,BCRYPT2Y
    "ip": "VARCHAR",                           // 最近登录 IP
    "is_dark_mode": "BOOLEAN",                 // 是否启用深色模式
    "permission": "VARCHAR",                   // 权限等级
    "last_sign_at": "DATETIME",                // 最后签到时间
    "register_at": "DATETIME",                 // 注册时间
    "verified": "BOOLEAN",                     // 是否已验证邮箱
    "verification_token": "VARCHAR",           // 邮箱验证 token
    "remember_token": "VARCHAR",               // 记住登录 token
    "username": "VARCHAR",                     // 用户名
    "realname": "VARCHAR",                     // 真实姓名
    "lastlogin": "DATETIME",                   // 最后登录时间

    // 以下字段来自游戏坐标系统（Minecraft）
    "x": "DOUBLE",                             // 坐标 X
    "y": "DOUBLE",                             // 坐标 Y
    "z": "DOUBLE",                             // 坐标 Z
    "world": "VARCHAR",                        // 所在世界名称
    "yaw": "FLOAT",                            // 朝向（水平）
    "pitch": "FLOAT",                          // 朝向（垂直）

    "regdate": "DATETIME",                     // 注册日期（可能与 register_at 重复）
    "regip": "VARCHAR",                        // 注册 IP

    "isLogged": "BOOLEAN",                     // 是否在线
    "hasSession": "BOOLEAN",                   // 是否有有效会话
    "totp": "VARCHAR"                          // 双因素认证密钥
  }
}
