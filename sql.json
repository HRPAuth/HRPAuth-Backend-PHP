{
  // ============================================================
  //  File: users.json
  //  Purpose:
  //    - 描述 MySQL 数据库中 "users" 表的字段结构
  //    - 供 code agent / LLM 自动识别字段类型、用途、约束
  //    - 可用于自动生成 SQL、ORM、API、数据校验逻辑等
  //
  //  MySQL Access:
  //    - 数据库通过 /config.php 中的 PDO 方式连接，例如：
  //        $pdo = new PDO($dsn, $username, $password);
  //    - agent 可根据此结构自动构建 SQL 查询或数据模型
  //
  //  Notes:
  //    - 字段类型根据示例数据进行了修正
  //    - regdate、lastlogin 为时间戳（毫秒）
  //    - isLogged / hasSession / verified / is_dark_mode 为 TINYINT(1)
  // ============================================================

  "table": "users",

  "columns": {
    "uid": "INT PRIMARY KEY AUTO_INCREMENT",   // 用户唯一 ID

    "email": "VARCHAR",                        // 邮箱
    "nickname": "VARCHAR",                     // 昵称
    "locale": "VARCHAR NULL",                  // 语言区域，可为空
    "score": "INT",                            // 用户积分
    "avatar": "VARCHAR",                       // 头像 ID 或 URL

    "password": "VARCHAR",                     // 密码哈希（bcrypt）
    "ip": "VARCHAR",                           // 最近登录 IP

    "is_dark_mode": "TINYINT(1)",              // 是否启用深色模式（0/1）
    "permission": "INT",                       // 权限等级（数字型）

    "last_sign_at": "DATETIME",                // 最后签到时间
    "register_at": "DATETIME",                 // 注册时间

    "verified": "TINYINT(1)",                  // 邮箱是否验证（0/1）
    "verification_token": "VARCHAR NULL",      // 邮箱验证 token，可为空
    "remember_token": "VARCHAR NULL",          // 记住登录 token，可为空

    "username": "VARCHAR",                     // 用户名
    "realname": "VARCHAR",                     // 真实姓名

    "lastlogin": "BIGINT",                     // 最后登录时间戳（毫秒）

    // 游戏坐标系统（如 Minecraft）
    "x": "DOUBLE",                             // 坐标 X
    "y": "DOUBLE",                             // 坐标 Y
    "z": "DOUBLE",                             // 坐标 Z
    "world": "VARCHAR",                        // 世界名称

    "regdate": "BIGINT",                       // 注册时间戳（毫秒）
    "regip": "VARCHAR",                        // 注册 IP

    "yaw": "FLOAT NULL",                       // 水平朝向，可为空
    "pitch": "FLOAT NULL",                     // 垂直朝向，可为空

    "isLogged": "TINYINT(1)",                  // 是否在线（0/1）
    "hasSession": "TINYINT(1)",                // 是否有有效会话（0/1）

    "totp": "VARCHAR NULL"                     // 双因素认证密钥，可为空
  }
}
